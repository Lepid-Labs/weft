{
	"name": "@lepid-labs/weft-embed",
	"version": "0.2.0",
	"description": "Weft's reader as a drop-in browser bundle: mount a document graph in any page",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lepid-Labs/weft.git",
		"directory": "packages/embed"
	},
	"homepage": "https://github.com/Lepid-Labs/weft/blob/main/docs/usage.md#embedding",
	"type": "module",
	"files": ["dist"],
	"exports": {
		".": {
			"import": "./dist/weft.js"
		},
		"./iife": "./dist/weft.iife.js",
		"./style.css": "./dist/weft.css",
		"./package.json": "./package.json"
	},
	"unpkg": "dist/weft.iife.js",
	"jsdelivr": "dist/weft.iife.js",
	"scripts": {
		"build": "vite build && node scripts/check-scoping.mjs",
		"dev": "vite build --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@lepid-labs/styles": "^1.0.2",
		"@lepid-labs/weft-core": "workspace:*",
		"@lepid-labs/weft-ui": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^22.0.0",
		"minisearch": "^7.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"svelte": "^5.56.10",
		"typescript": "^5.7.0",
		"unified": "^11.0.0",
		"vite": "^6.4.3",
		"yaml": "^2.6.0"
	}
}
